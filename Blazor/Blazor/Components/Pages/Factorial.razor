@rendermode InteractiveServer
@using System.Numerics;

<hr />
<h3>Factorial</h3>
<div class="factorial">
	<input type="number" @bind="n" @bind:after="Calculate" />
	<h3>@n! = @f</h3>
	@* <button @onclick="Calculate" class="btn btn-primary">Вычислить</button> *@
</div>
<hr />

@code
{
	int n;      //Исходное число для вычисления Факториала
	BigInteger f = 1;  //Факториал числа
	void Calculate()
	{
		f = 1;
		for (int i = 1; i <= n; i++)
		{
			f *= i;
		}
	}
}
